FROM node:20-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    NODE_PATH=/usr/local/lib/node_modules

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    cmake \
    curl \
    git \
    jq \
    libopenblas-dev \
    python3 \
    python3-pip \
    python3-venv \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "$VIRTUAL_ENV" \
    && python -m pip install --upgrade pip \
    && python -m pip install requests==2.32.3 openai==1.35.13 \
    && printf '%s\n' 'export PATH="/opt/venv/bin:$PATH"' > /etc/profile.d/taintp2x.sh

# The official TypeScript Compiler API is the source-identification frontend.
RUN npm install --global typescript@5.4.5 pnpm@9.15.5

WORKDIR /taintp2x
COPY . /taintp2x/

RUN node --version \
    && tsc --version \
    && python --version \
    && python -c "import requests"

CMD ["bash"]
